{
  "name": "influencial",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "scripts": {
    "build": "turbo build",
    "db:generate": "pnpm --filter './packages/db-*' generate",
    "db:migrate": "pnpm --filter './packages/db-*' migrate",
    "dev": "turbo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}
