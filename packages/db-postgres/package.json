{
  "name": "@influencial/db-postgres",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./dist/schema.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts --format esm --out-dir dist --clean",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0"
  }
}
